{
  "label": "unkeyed-query-cookie-and-directives",
  "note": "Fabricated capture exercising the query, cookie, method, Range, fat-GET and Cache-Control rules.",
  "entries": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.example/search?q=shoes&lang=en",
        "headers": [
          {
            "name": "Host",
            "value": "www.example"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": [
          {
            "name": "Content-Type",
            "value": "text/html"
          },
          {
            "name": "Cache-Control",
            "value": "public, max-age=60"
          },
          {
            "name": "X-Cache",
            "value": "MISS"
          }
        ],
        "body": "<h1>Results for shoes</h1><p>Showing 12 results in English.</p>"
      }
    },
